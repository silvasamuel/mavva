      ],
      "accepted_answers": null,
      "explanation": "\"Talita cumi, que, traduzido, é: Menina, a ti te digo, levanta-te\" (Mc 5:41). Marcos preserva o aramaico original de Jesus em vários momentos — Efatá (\"abre-te\", Mc 7:34) é outro exemplo.",
      "divergence_note": null,
      "reference": {
        "book": "marcos",
        "chapter": 5,
        "verse_start": 41,
        "verse_end": 42
      },
      "difficulty": "medium"
